{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sms-bridge.invalid/schema/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "protocol_version": {
      "const": 1
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "E.164 when the phone can normalize it, otherwise the raw sender (short code or alphanumeric)."
    },
    "message_id": {
      "type": "string",
      "pattern": "^(sms|mms):[0-9]+$"
    },
    "thread_id": {
      "type": "integer",
      "minimum": 0
    },
    "epoch_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nullable_cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "client_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 of the DER certificate."
    },
    "send_status": {
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed"
      ]
    },
    "error_code": {
      "enum": [
        "bad_request",
        "bad_cursor",
        "unauthorized",
        "pairing_invalid",
        "pairing_rejected",
        "rate_limited",
        "not_found",
        "unsupported_version",
        "not_default_sms_app",
        "not_permitted",
        "send_failed",
        "internal"
      ]
    },
    "nullable_address": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "description": "An address, or null when the other party withheld the number or the phone does not know it."
    },
    "call_id": {
      "type": "string",
      "pattern": "^call:[0-9]+$"
    },
    "call_kind": {
      "enum": [
        "in",
        "out",
        "missed",
        "rejected",
        "blocked",
        "voicemail"
      ],
      "description": "in: answered inbound. out: placed, answered or not. missed: rang and was not answered. rejected: declined by the user. blocked: stopped by the phone before ringing. voicemail: went to voicemail."
    },
    "call_abilities": {
      "type": "object",
      "description": "What the phone can do with calls given the permissions it holds right now. Absent on a phone that does not know about calls.",
      "properties": {
        "history": {
          "type": "boolean",
          "description": "GET /calls and `call` frames work, and `call_state` carries numbers."
        },
        "dial": {
          "type": "boolean"
        },
        "answer": {
          "type": "boolean"
        },
        "end": {
          "type": "boolean",
          "description": "Declining a ringing call and hanging up."
        }
      },
      "required": [
        "history",
        "dial",
        "answer",
        "end"
      ],
      "additionalProperties": false
    }
  }
}
